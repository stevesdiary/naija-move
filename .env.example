# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars

# Upstash Redis (BullMQ + cache)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Upstash Redis IORedis-compatible URL (for BullMQ)
REDIS_URL=rediss://:your-password@your-redis.upstash.io:6380

# QStash
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# Mapbox
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# Internal
INTERNAL_JOB_SECRET=change-me-internal-job-secret-min-32-chars

# App URL (used by QStash to call back)
APP_URL=https://your-app.onrender.com
