# Server
NODE_ENV=development
PORT=3000

# Database
# PEM CA for the DB host. Multi-line values MUST be double-quoted for dotenv to read past the first line.
# DATABASE_CERT="-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----"
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
JWT_ACCESS_SECRET=   # openssl rand -hex 32
JWT_REFRESH_SECRET=  # openssl rand -hex 32 (must differ from access secret)

# Upstash Redis (BullMQ + cache)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# Upstash Redis IORedis-compatible URL (for BullMQ)
REDIS_URL=rediss://:your-password@your-redis.upstash.io:6380

# QStash
QSTASH_TOKEN=your-qstash-token
QSTASH_CURRENT_SIGNING_KEY=your-current-signing-key
QSTASH_NEXT_SIGNING_KEY=your-next-signing-key

# Map Providers (OSM-first, Mapbox only as fallback)
# Routing: OSRM (OSM-based, free, no key) - PRIMARY
#          Mapbox - FALLBACK only if configured
# MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Geocoding: Photon/Nominatim (OSM-based, free, no key) - PRIMARY
#            Mapbox - FALLBACK only if configured

# Tile Providers for Map Display (choose one):
# MapTiler (recommended for Nigeria - CDN in Africa)
MAPTILER_TOKEN=your-maptiler-token

# Stadia Maps (Alibaba Cloud CDN - fast in Africa)
# STADIA_MAPS_TOKEN=your-stadia-token

# Optional fallbacks (only needed if OSM services unavailable)
# MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret

# Internal
INTERNAL_JOB_SECRET= # openssl rand -hex 32

# App URL (used by QStash to call back)
APP_URL=https://your-app.onrender.com
# Networking
TRUST_PROXY=0                          # hops to trust for X-Forwarded-For (1 behind a single LB)
CORS_ORIGINS=http://localhost:5173     # comma-separated; the admin dashboard origin(s)
